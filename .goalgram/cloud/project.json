{
  "name": "GoalgramCloud",
  "options": {
    "deploymentTarget": {
      "iOS": "15.0"
    },
    "createIntermediateGroups": true,
    "generateEmptyDirectories": true
  },
  "settings": {
    "base": {
      "DEVELOPMENT_TEAM": "KCX4AZY2QZ",
      "CODE_SIGN_STYLE": "Automatic",
      "MARKETING_VERSION": "13.1.1",
      "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
      "TARGETED_DEVICE_FAMILY": "1,2"
    }
  },
  "targets": {
    "Telegram": {
      "type": "application",
      "platform": "iOS",
      "info": {
        "path": "Telegram/Info.plist"
      },
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "com.haocheng.goalgram",
          "PRODUCT_NAME": "Telegram",
          "EXECUTABLE_NAME": "Telegram",
          "CODE_SIGN_ENTITLEMENTS": "Telegram/Goalgram.entitlements",
          "GENERATE_INFOPLIST_FILE": "NO",
          "DEBUG_INFORMATION_FORMAT": "dwarf",
          "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
          "SWIFT_VERSION": "5.0",
          "SKIP_INSTALL": "NO"
        }
      },
      "postBuildScripts": [
        {
          "name": "Stage real Bazel product",
          "script": "python3 -I \"$SRCROOT/stage-bundle.py\"",
          "basedOnDependencyAnalysis": false
        }
      ],
      "dependencies": [
        {
          "target": "BroadcastUploadExtension",
          "embed": true
        },
        {
          "target": "IntentsExtension",
          "embed": true
        },
        {
          "target": "NotificationContentExtension",
          "embed": true
        },
        {
          "target": "NotificationServiceExtensionv1",
          "embed": true
        },
        {
          "target": "ShareExtension",
          "embed": true
        },
        {
          "target": "WidgetExtension",
          "embed": true
        }
      ]
    },
